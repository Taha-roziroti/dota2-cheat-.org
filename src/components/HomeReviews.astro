---
import { customerReviews, customerReviewStats } from '../data/site';
import { getReviewPath, getReviewsBasePath } from '../data/reviews';
import { getLocalizedReviewBySlug } from '../data/localized-reviews';
import { defaultLocale, localeMap, type LocaleCode } from '../data/i18n/locales';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const reviewsHref = getReviewsBasePath(locale);
const reviews = customerReviews.map((review) => {
	const localized = getLocalizedReviewBySlug(review.slug, locale) ?? review;
	return {
		slug: localized.slug,
		handle: localized.handle,
		text: localized.text,
		short: localized.short,
		date: localized.date,
		rating: localized.rating,
		href: getReviewPath(localized.slug, locale),
	};
});

const ratingLabel = customerReviewStats.averageRating.toFixed(1);
const countLabel = customerReviewStats.reviewCountLabel || String(customerReviewStats.totalCount);
const carouselLabel = t('reviews.carouselAria');

function formatDate(iso: string) {
	const tag = localeMap[locale]?.hreflang ?? locale;
	return new Date(`${iso}T12:00:00`).toLocaleDateString(tag, {
		month: 'long',
		year: 'numeric',
	});
}

function initial(handle: string) {
	return handle.replace(/^@/, '').charAt(0).toUpperCase();
}
---

<section class="reviews" aria-labelledby="reviews-title">
	<div class="shell">
		<header class="reviews__head">
			<div class="reviews__head-copy">
				<p class="reviews__eyebrow">{t('reviews.eyebrow')}</p>
				<h2 id="reviews-title">{t('reviews.homeTitle')}</h2>
			</div>
			<div
				class="reviews__score"
				aria-label={t('reviews.averageAria', { rating: ratingLabel, count: countLabel })}
			>
				<strong>{ratingLabel}</strong>
				<div>
					<span class="reviews__stars" aria-hidden="true">
						{
							[0, 1, 2, 3, 4].map(() => (
								<svg viewBox="0 0 20 20" fill="currentColor">
									<path d="M10 2.5l2.2 5.1 5.5.5-4.2 3.7 1.3 5.4L10 14.4 5.2 17.2l1.3-5.4L2.3 8.1l5.5-.5L10 2.5z" />
								</svg>
							))
						}
					</span>
					<p>{t('reviews.buyerReviews', { count: countLabel })}</p>
				</div>
			</div>
		</header>
	</div>

	<div class="reviews__3d" data-reviews-3d>
		<div class="reviews__3d-controls">
			<button type="button" class="reviews__3d-btn" data-reviews-prev aria-label={t('reviews.prev', { defaultValue: 'Previous review' })}>
				<span aria-hidden="true">‹</span>
			</button>
			<button type="button" class="reviews__3d-btn" data-reviews-next aria-label={t('reviews.next', { defaultValue: 'Next review' })}>
				<span aria-hidden="true">›</span>
			</button>
		</div>
		<div
			class="reviews__3d-viewport"
			data-reviews-viewport
			tabindex="0"
			role="region"
			aria-label={carouselLabel}
		>
			<ul class="reviews__3d-stage" data-reviews-stage>
				{
					reviews.map((review, index) => (
						<li class="review-card-3d" data-review-index={index}>
							<article class="review-card">
								<p class="review-card__text">{review.short ?? review.text}</p>
								<footer class="review-card__foot">
									<span class="review-card__avatar" aria-hidden="true">
										{initial(review.handle)}
									</span>
									<div>
										<a class="review-card__name" href={review.href}>
											{review.handle}
										</a>
										<time datetime={review.date}>{formatDate(review.date)}</time>
									</div>
									<span
										class="review-card__rating"
										aria-label={t('reviews.outOfFiveAria', { rating: review.rating })}
									>
										{review.rating}/5
									</span>
								</footer>
							</article>
						</li>
					))
				}
			</ul>
		</div>
		<p class="reviews__3d-hint">{t('reviews.scrollHint')}</p>
	</div>

	<script is:inline>
		(function () {
			var root = document.querySelector('[data-reviews-3d]');
			if (!root) return;
			var viewport = root.querySelector('[data-reviews-viewport]');
			var stage = root.querySelector('[data-reviews-stage]');
			var prevBtn = root.querySelector('[data-reviews-prev]');
			var nextBtn = root.querySelector('[data-reviews-next]');
			if (!viewport || !stage) return;

			var cards = Array.prototype.slice.call(stage.querySelectorAll('[data-review-index]'));
			if (!cards.length) return;

			var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			var index = 0;
			var radius = 420;
			var angleStep = 360 / cards.length;
			var dragging = false;
			var startX = 0;
			var startIndex = 0;

			function layout() {
				var w = window.innerWidth;
				radius = w < 480 ? 260 : w < 760 ? 320 : 420;
				cards.forEach(function (card, i) {
					var offset = i - index;
					var angle = offset * angleStep;
					var rad = (angle * Math.PI) / 180;
					var x = Math.sin(rad) * radius;
					var z = Math.cos(rad) * radius - radius;
					var scale = 0.82 + (z + radius) / (radius * 2.2) * 0.22;
					var opacity = 0.35 + (z + radius) / (radius * 1.4) * 0.65;
					card.style.transform =
						'translate3d(' +
						x +
						'px, 0, ' +
						z +
						'px) rotateY(' +
						-angle +
						'deg) scale(' +
						scale.toFixed(3) +
						')';
					card.style.opacity = Math.min(1, opacity).toFixed(3);
					card.style.zIndex = String(Math.round(z + radius));
					card.setAttribute('aria-hidden', offset === 0 ? 'false' : 'true');
				});
			}

			function setIndex(next) {
				index = ((next % cards.length) + cards.length) % cards.length;
				layout();
			}

			function onWheel(e) {
				if (reduced) return;
				if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
				e.preventDefault();
				if (e.deltaX > 0) setIndex(index + 1);
				else if (e.deltaX < 0) setIndex(index - 1);
			}

			function onPointerDown(e) {
				if (e.pointerType === 'mouse' && e.button !== 0) return;
				dragging = true;
				startX = e.clientX;
				startIndex = index;
				viewport.setPointerCapture(e.pointerId);
			}

			function onPointerMove(e) {
				if (!dragging) return;
				var dx = e.clientX - startX;
				var steps = Math.round(-dx / 90);
				setIndex(startIndex + steps);
			}

			function onPointerUp(e) {
				dragging = false;
				try {
					viewport.releasePointerCapture(e.pointerId);
				} catch (err) {}
			}

			function onKeyDown(e) {
				if (e.key === 'ArrowLeft') {
					e.preventDefault();
					setIndex(index - 1);
				} else if (e.key === 'ArrowRight') {
					e.preventDefault();
					setIndex(index + 1);
				} else if (e.key === 'Home') {
					e.preventDefault();
					setIndex(0);
				} else if (e.key === 'End') {
					e.preventDefault();
					setIndex(cards.length - 1);
				}
			}

			if (prevBtn) prevBtn.addEventListener('click', function () { setIndex(index - 1); });
			if (nextBtn) nextBtn.addEventListener('click', function () { setIndex(index + 1); });
			viewport.addEventListener('wheel', onWheel, { passive: false });
			viewport.addEventListener('pointerdown', onPointerDown);
			viewport.addEventListener('pointermove', onPointerMove);
			viewport.addEventListener('pointerup', onPointerUp);
			viewport.addEventListener('pointercancel', onPointerUp);
			viewport.addEventListener('keydown', onKeyDown);
			window.addEventListener('resize', layout);

			layout();

			if (!reduced && window.matchMedia('(min-width: 761px)').matches) {
				var auto = window.setInterval(function () {
					setIndex(index + 1);
				}, 6000);
				root.addEventListener('pointerenter', function () {
					window.clearInterval(auto);
				});
			}
		})();
	</script>

	<div class="shell">
		<p class="reviews__more">
			<a href={reviewsHref}>{t('reviews.readAll')}</a>
		</p>
	</div>
</section>

<style is:global>
	.reviews {
		padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 3.5rem);
		background: var(--bg);
		border-top: 1px solid var(--line-soft);
		overflow: hidden;
	}

	.reviews__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem 2rem;
		margin: 0 0 1.75rem;
		padding-bottom: 1.35rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.reviews__head-copy {
		max-width: none;
		min-width: 0;
	}

	.reviews__eyebrow {
		margin: 0 0 0.4rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.reviews__head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		font-weight: 700;
		letter-spacing: 0.05em;
		line-height: 1.25;
		color: var(--ink);
	}

	.reviews__score {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		flex-shrink: 0;
		margin-top: 0;
		padding: 0.7rem 0.95rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
	}

	.reviews__score strong {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		line-height: 1;
		color: var(--ink);
	}

	.reviews__stars {
		display: flex;
		gap: 0.12rem;
		color: var(--magenta-soft);
	}

	.reviews__stars svg {
		width: 0.85rem;
		height: 0.85rem;
	}

	.reviews__score p {
		margin: 0.25rem 0 0;
		font-size: 0.75rem;
		color: var(--ink-muted);
		white-space: nowrap;
	}

	.reviews__3d {
		position: relative;
		margin: 0 auto;
		max-width: 100%;
	}

	.reviews__3d-controls {
		display: flex;
		justify-content: center;
		gap: 0.65rem;
		margin-bottom: 0.65rem;
	}

	.reviews__3d-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: var(--touch-min, 2.75rem);
		min-height: var(--touch-min, 2.75rem);
		padding: 0 0.85rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--bg-panel);
		color: var(--ink);
		font-size: 1.35rem;
		line-height: 1;
		cursor: pointer;
		transition: border-color 0.2s ease, background 0.2s ease;
	}

	.reviews__3d-btn:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		background: var(--bg-elevated);
	}

	.reviews__3d-btn:focus-visible {
		outline: 2px solid var(--magenta-soft);
		outline-offset: 2px;
	}

	.reviews__3d-viewport {
		position: relative;
		height: clamp(16rem, 34vw, 20rem);
		margin-inline: auto;
		max-width: min(72rem, 100%);
		perspective: 1200px;
		perspective-origin: 50% 42%;
		cursor: grab;
		touch-action: pan-y pinch-zoom;
		outline: none;
	}

	.reviews__3d-viewport:focus-visible {
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--magenta) 35%, transparent);
		border-radius: var(--radius-md);
	}

	.reviews__3d-viewport:active {
		cursor: grabbing;
	}

	.reviews__3d-stage {
		position: absolute;
		inset: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		transform-style: preserve-3d;
	}

	.review-card-3d {
		position: absolute;
		left: 50%;
		top: 50%;
		width: min(20.5rem, 78vw);
		margin-left: calc(min(20.5rem, 78vw) / -2);
		margin-top: -5.75rem;
		transform-style: preserve-3d;
		transition:
			transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.45s ease;
		will-change: transform, opacity;
	}

	.reviews__3d-hint {
		margin: 0.75rem 0 0;
		text-align: center;
		font-size: 0.72rem;
		color: var(--ink-muted);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	@media (max-width: 760px) {
		.reviews__head {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.85rem;
		}

		.reviews__score {
			width: 100%;
			justify-content: flex-start;
		}

		.reviews__score p {
			white-space: normal;
		}

		.review-card-3d {
			width: min(18.5rem, 82vw);
			margin-left: calc(min(18.5rem, 82vw) / -2);
		}
	}

	@media (max-width: 480px) {
		.reviews {
			padding-block: 2.25rem 2rem;
		}

		.review-card-3d {
			width: min(17rem, 86vw);
			margin-left: calc(min(17rem, 86vw) / -2);
		}

		.reviews__3d-viewport {
			height: clamp(15rem, 52vw, 18rem);
		}
	}

	.review-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 11.5rem;
		padding: 1.2rem 1.15rem 1.1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		box-shadow:
			0 12px 40px rgba(0, 0, 0, 0.35),
			0 0 0 1px color-mix(in srgb, var(--magenta) 8%, transparent) inset;
		backface-visibility: hidden;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.review-card:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		background: var(--bg-elevated);
	}

	.review-card__text {
		margin: 0;
		flex: 1;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.review-card__foot {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.7rem;
		margin-top: 1.15rem;
		padding-top: 0.95rem;
		border-top: 1px solid var(--line-soft);
	}

	.review-card__avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--magenta) 16%, var(--bg-elevated));
		border: 1px solid color-mix(in srgb, var(--magenta) 28%, var(--line));
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--magenta-soft);
	}

	.review-card__name {
		display: block;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--ink);
		line-height: 1.2;
		text-decoration: none;
	}

	a.review-card__name:hover {
		color: var(--accent-hover);
	}

	.review-card__foot time {
		display: block;
		margin-top: 0.15rem;
		font-size: 0.75rem;
		color: var(--ink-muted);
	}

	.review-card__rating {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--magenta-soft);
		white-space: nowrap;
	}

	.reviews__more {
		margin: 1.5rem 0 0;
		text-align: center;
	}

	.reviews__more a {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--ink-muted);
		min-height: var(--touch-min, 2.75rem);
		display: inline-flex;
		align-items: center;
	}

	.reviews__more a:hover {
		color: var(--accent-hover);
	}

	@media (prefers-reduced-motion: reduce) {
		.review-card-3d {
			position: static;
			width: 100%;
			margin: 0 0 0.75rem;
			opacity: 1 !important;
			transform: none !important;
		}

		.reviews__3d-viewport {
			height: auto;
			perspective: none;
			cursor: default;
		}

		.reviews__3d-stage {
			position: static;
			display: grid;
			gap: 0.75rem;
			padding-inline: var(--page-gutter);
		}

		.reviews__3d-controls {
			display: none;
		}

		.reviews__3d-hint {
			display: none;
		}
	}
</style>
