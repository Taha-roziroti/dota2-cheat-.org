---
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getBlogBasePath } from '../data/blog/helpers';
import { getReviewsBasePath } from '../data/reviews';
import { siteConfig } from '../data/site';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const year = new Date().getFullYear();
const shareUrl = `${siteConfig.url}/`;
const encodedUrl = encodeURIComponent(shareUrl);
const encodedName = encodeURIComponent(siteConfig.name);
const tagline = t('footer.tagline').split('\n')[0];

const explore = [
	{ labelKey: 'footer.linkCheatsGuide', href: getLocalizedPath('hacks', locale) },
	{ labelKey: 'footer.linkEspPage', href: getLocalizedPath('dota2-esp', locale) },
	{ labelKey: 'footer.linkAimbotPage', href: getLocalizedPath('dota2-aimbot', locale) },
	{ labelKey: 'footer.linkFeatureList', href: getLocalizedPath('features', locale) },
	{ labelKey: 'footer.linkPricingPlans', href: getLocalizedPath('pricing', locale) },
	{ labelKey: 'footer.linkFaqHub', href: getLocalizedPath('faq', locale) },
	{ labelKey: 'footer.linkForums', href: getBlogBasePath(locale) },
];

const help = [
	{ labelKey: 'footer.linkSetupGuide', href: getLocalizedPath('setup', locale) },
	{ labelKey: 'footer.linkPatchStatus', href: getLocalizedPath('updates', locale) },
	{ labelKey: 'footer.linkBuyerReviews', href: getReviewsBasePath(locale) },
	{ labelKey: 'footer.linkSupportDesk', href: getLocalizedPath('support', locale) },
	{ labelKey: 'footer.linkRefundPolicy', href: getLocalizedPath('refund', locale) },
	{ labelKey: 'footer.linkPrivacyPolicy', href: getLocalizedPath('privacy', locale) },
	{ labelKey: 'footer.linkTermsOfUse', href: getLocalizedPath('terms', locale) },
];

const shareLinks = [
	{
		label: t('common.shareX'),
		href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedName}`,
	},
	{
		label: t('common.shareReddit'),
		href: `https://reddit.com/submit?url=${encodedUrl}&title=${encodedName}`,
	},
	{
		label: t('common.shareFacebook'),
		href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
	},
];
---

<footer class="site-footer">
	<div class="shell site-footer__grid">
		<div>
			<p class="site-footer__brand">{siteConfig.name}</p>
			<p>{tagline}</p>
			<p class="site-footer__share-label">{t('common.share')}</p>
			<ul class="site-footer__share">
				{
					shareLinks.map((link) => (
						<li>
							<a href={link.href} rel="noopener noreferrer" target="_blank">{link.label}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<p class="site-footer__label">{t('footer.explore')}</p>
			<ul>
				{
					explore.map((link) => (
						<li>
							<a href={link.href}>{t(link.labelKey)}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<p class="site-footer__label">{t('footer.help')}</p>
			<ul>
				{
					help.map((link) => (
						<li>
							<a href={link.href}>{t(link.labelKey)}</a>
						</li>
					))
				}
				<li>
					<a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>
				</li>
			</ul>
		</div>
	</div>
	<div class="shell site-footer__bottom">
		<p>{t('common.copyright', { year, brand: siteConfig.name })}</p>
	</div>
</footer>

<style is:global>
	.site-footer {
		background: var(--bg-panel);
		border-top: 1px solid var(--line-soft);
		padding-top: 3rem;
		content-visibility: auto;
		contain-intrinsic-size: 1px 360px;
	}

	.site-footer__grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr;
		gap: 2rem;
		padding-bottom: 2.25rem;
	}

	.site-footer__brand {
		display: block;
		margin: 0 0 0.65rem;
		font-family: var(--font-display);
		font-size: 1.45rem;
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.site-footer__share-label {
		margin: 1.1rem 0 0.45rem !important;
		font-size: 0.75rem !important;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-faint) !important;
	}

	.site-footer__share {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1rem;
	}

	.site-footer__share a {
		font-size: 0.85rem;
		color: var(--ink-muted);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.site-footer__share a:hover {
		color: var(--accent-hover);
	}

	.site-footer p {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--ink-faint);
		max-width: 20rem;
	}

	.site-footer__label {
		margin: 0 0 0.85rem !important;
		font-size: 0.75rem !important;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-muted) !important;
	}

	.site-footer ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.site-footer a:not(.site-footer__brand) {
		font-size: 0.875rem;
		color: var(--ink-muted);
	}

	.site-footer a:not(.site-footer__brand):hover {
		color: var(--ink);
	}

	.site-footer__bottom {
		border-top: 1px solid var(--line-soft);
		padding: 1.1rem 0 1.6rem;
	}

	.site-footer__bottom p {
		max-width: none;
		font-size: 0.75rem;
	}

	@media (max-width: 760px) {
		.site-footer__grid {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.site-footer a:not(.site-footer__brand) {
			display: inline-flex;
			align-items: center;
			min-height: var(--touch-min, 2.75rem);
			overflow-wrap: anywhere;
		}

		.site-footer__bottom {
			padding-bottom: max(1.35rem, var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
		}
	}
</style>
